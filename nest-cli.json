{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/pasarela-pagos/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/pasarela-pagos/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/pasarela-pagos",
  "projects": {
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "merchant-service": {
      "type": "application",
      "root": "apps/merchant-service",
      "entryFile": "main",
      "sourceRoot": "apps/merchant-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/merchant-service/tsconfig.app.json"
      }
    },
    "pasarela-pagos": {
      "type": "application",
      "root": "apps/pasarela-pagos",
      "entryFile": "main",
      "sourceRoot": "apps/pasarela-pagos/src",
      "compilerOptions": {
        "tsConfigPath": "apps/pasarela-pagos/tsconfig.app.json"
      }
    },
    "settlement-service": {
      "type": "application",
      "root": "apps/settlement-service",
      "entryFile": "main",
      "sourceRoot": "apps/settlement-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/settlement-service/tsconfig.app.json"
      }
    },
    "transaction-service": {
      "type": "application",
      "root": "apps/transaction-service",
      "entryFile": "main",
      "sourceRoot": "apps/transaction-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/transaction-service/tsconfig.app.json"
      }
    },
    "webhook-service": {
      "type": "application",
      "root": "apps/webhook-service",
      "entryFile": "main",
      "sourceRoot": "apps/webhook-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/webhook-service/tsconfig.app.json"
      }
    }
  }
}